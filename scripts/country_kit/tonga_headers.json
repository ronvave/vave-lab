ecognition episodes; ordinary scholarships are kept in the funding sheet."], [], ["Award ID", "Scholar ID", "Scholar Name", "Award Year", "Award / Recognition", "Category", "Gold Medal / Prize?", "Qualification / Career Stage", "Awarding Body", "Country", "Verification Status", "Source URL", "Verification Note", "Counts Toward Award Total?", "Related Degree ID", "Related Publication ID", "Public Display Approved", "Created At", "Created By", "Updated At", "Updated By"]], "Positions": [["Academic, Professional & Leadership Position History"], ["One row per appointment. Academic rank and leadership are stored separately."], [], ["Position ID", "Scholar ID", "Scholar Name", "Institution", "Country", "Department / Unit", "Academic / Professional Title (verbatim)", "Standardized Academic Rank", "Leadership Title (verbatim)", "Standardized Leadership Category", "Leadership Level", "Role Status", "Start Year", "End Year", "Source URL", "Evidence / Notes", "Last Verified", "Institution ID", "Employment Type", "Profile URL", "Verification Status", "Record Notes", "Public Display Approved", "Created At", "Created By", "Updated At", "Updated By"]], "M>PhD mobility": [["M>PhD Mobility"], ["One row per Tongan scholar with a completed Master's and a completed or in-progress PhD. Uses the original mobility field structure, adds the Master File Scholar ID, and resolves university coordinates through Lookups."], [], ["Scholar ID", "Degree(s)", "scholar_id", "scholar", "last", "first", "New?", "m_uni", "m_in", "m_city", "m_country", "m_region", "m_lon", "m_lat", "m_year", "m_title", "p_uni", "p_in", "p_city", "p_country", "p_region", "p_lon", "p_lat", "p_year", "p_title", "Info link1", "Info link2", "Notes"]], "Publications": [["Publications & Theses — BibTeX Index"], ["Full confidential publication corpus, one item per row. Record Source distinguishes the original Zotero import from newly discovered records; Deduplication Key is used to prevent DOI/title-year duplicates before additions."], [], ["Publication ID / BibTeX Key", "Entry Type", "Publication Type", "Title", "Year", "Journal / Book Title", "Publisher / Institution / School", "DOI", "URL", "Keywords", "Abstract", "Tagged Tonga?", "Tagged Tongan?", "Thesis Level", "Linked Tongan Scholar Count", "Auth_Lead Scholar ID", "Co-Auth_Scholar IDs", "Record Source", "Source Database / Repository", "Discovery / Source URL", "Deduplication Key", "Bibliographic Lead Author", "Bibliographic Author Count", "Tongatapu", "Vava'u", "Ha'apai", "'Eua", "Ongo Niua", "Kolofo'ou", "Kolomotu'a", "Vaini", "Tatakamotonga", "Lapaha", "Nukunuku", "Kolovai", "Neiafu", "Pangaimotu", "Hahake", "Leimatu'a", "Hihifo", "Motu", "Pangai (Lifuka)", "Foa", "Lulunga", "Mu'omu'a", "Ha'ano", "'Uiha", "'Eua Motu'a", "'Eua Fo'ou", "Niuatoputapu", "Niuafo'ou", "Tonga - no district specified", "Unsure", "BibTeX Key", "Publication Status", "Authors — Full Ordered List", "Volume", "Issue", "Pages", "Handle / ISBN", "Open Access URL", "Language", "About Country?", "Dedup Status", "Merged Into", "Verification Status", "Source ID", "Last Checked", "Record Notes", "Public Display Approved", "Created At", "Created By", "Updated At", "Updated By"]], "Authorship": [["Tongan Scholar ↔ Publication Authorship Bridge"], ["Conservative exact/known-alias links between active Scholar IDs and BibTeX author strings."], [], ["Authorship ID", "Scholar ID", "Scholar Name", "Publication ID / BibTeX Key", "Author Name as Recorded", "Author Position", "Is First Author?", "Reconciliation Notes", "Corresponding Author?", "Affiliation at Publication", "Match Basis", "Verification Status", "Evidence Source ID", "Created At", "Created By", "Updated At", "Updated By"]], "Researcher Authorship": [["Researcher Authorship"], ["One-to-many links between TON-R researchers and publications. This does not alter the scholar-only Authorship register."], [], ["Researcher Authorship ID", "Researcher ID", "Researcher Name", "Publication ID / BibTeX Key", "Author Name as Recorded", "Author Position", "Is First Author?", "Role / Contribution", "Affiliation at Publication", "Evidence URL", "Verification", "Last Checked"]], "Research Geography": [["Research Geography Coding"], ["Evidence-based coding of where research was conducted. Add one row per verified publication–location relationship. For research in Tonga, record Island Division, District, Specific Island and Village/Town/Site where supported; for research outside Tonga, record the country. Island Division auto-populates from District. Do not infer study location from author origin, affiliation, title keywords or topic alone."], [], ["Geography Record ID", "Publication ID / BibTeX Key", "Scholar ID (optional)", "Geography Type", "Country", "District", "Village / Town / Site", "Specific Island", "Island Division (auto from District)", "Coding Basis / Evidence", "Source URL / Note", "Verification", "Last Checked", "Latitude", "Longitude", "Sensitivity", "Multi-Attribution Group ID", "Public Display Approved", "Record Notes", "Created At", "Created By", "Updated At", "Updated By"]], "Research Geography Coordinates": [["Research Geography Coordinates"], ["Canonical dashboard marker coordinates for verified Research Geography country, island-division, specific-island, and study-site labels. Decimal degrees; research location only—not author affiliation."], [], ["Location Type", "Canonical Location Name", "Country", "Island Division", "Specific Island", "Longitude", "Latitude", "Coordinate Convention", "Coordinate Source URL", "Verification / Status", "Last Checked", "Alias Notes"]], "Institutions": [["Institutions"], ["Study and work institutions appearing in relational records. Region/coordinates are populated from the confidential mobility workbook where supplied."], [], ["Institution", "Country", "Study Source?", "Work Source?", "Degree Episodes", "Current Position Records", "Total Link Records", "Region", "Longitude", "Latitude", "Institution ID", "Original Name / Alias", "Institution Type", "City / Locality", "Website", "Name Status", "Active", "Source ID", "Record Notes", "Created At", "Created By", "Updated At", "Updated By"]], "News": [["Scholar News — Panel A4 \"Celebrating Tongan scholars\""], ["One row per story. Set Show on Dashboard = Yes to publish at the next Tonga refresh. Publication Date as YYYY-MM-DD (for defenses and events, use the event date). Announcement Type: News, Defense, Thesis (new thesis), Publication (new publication) or Event (includes webinars, talks, workshops, conferences and launches); blank = News. New theses and publications must be by Tongan scholars or about Tonga; if the author is not in the database, leave Scholar ID blank and enter the author name(s) in Scholar Display Name. Category (news only): Award, Appointment, Graduation, Milestone, Publication, Research or News (general news with no more specific category). Event Time and Event Location apply to defenses and events and are shown as written. Summary is written by the curator (do not copy article text). Notes, Added By and Added On stay private. Links sent through the dashboard Share a story form arrive in the News Submissions tab and are added here when approved in Admin."], [], ["News ID", "Scholar ID", "Scholar Display Name", "Category", "Headline", "Outlet", "Publication Date", "Article URL", "Image URL", "Image Credit", "Summary", "Also Covered By", "Show on Dashboard", "Added By", "Added On", "Notes", "Announcement Type", "Event Time", "Event Location"]]}