#!/usr/bin/env bash
# Pre-push guardrail. See scripts/verify_enc_freshness.py for the
# actual logic. Repo-tracked so it survives fresh clones once
# core.hooksPath is pointed at .githooks (see scripts/install_hooks.sh).
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"

python3 "$REPO_ROOT/scripts/validate_dashboard_integrity.py" --revision HEAD
exec python3 "$REPO_ROOT/scripts/verify_enc_freshness.py"
